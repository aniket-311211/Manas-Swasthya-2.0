# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# Anything prefixed VITE_ is compiled into the browser bundle and is PUBLIC.
# Never put a secret behind that prefix. Everything else is server-only.

# ── Frontend (public — shipped to every browser) ─────────────────────────────

# Clerk publishable key — dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Optional. Defaults to /api, which is correct for Vercel and for the local
# Vite proxy. Only set this if the API lives somewhere else.
# VITE_API_URL=http://localhost:3001/api


# ── Backend (secret — never prefixed with VITE_) ─────────────────────────────

# Postgres connection string — console.neon.tech, or any Postgres.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Clerk secret key — dashboard.clerk.com → API Keys.
# REQUIRED. Every user-scoped endpoint verifies the session token against this.
# If it is missing the server authenticates nobody and returns 401 to everyone,
# which is deliberate: a deploy that forgets it should break loudly rather than
# quietly stop checking.
CLERK_SECRET_KEY=sk_test_your_key_here

# Google Gemini API key — aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Local API server port
PORT=3001


# ── Access codes (optional — both default to empty) ──────────────────────────

# Consultation fee waiver codes, comma-separated. `CODE` or `CODE:Label`.
# These are redeemed for a real discount, so they live here rather than in the
# source tree where anyone reading the repository could use them.
# Empty means no code works.
# BOOKING_COUPON_CODES=EXAMPLE1234:Campus drive,EXAMPLE5678:Orientation

# Standard consultation fee in paise. Defaults to 49900 (₹499).
# BOOKING_FEE_PAISE=49900

# Mentor signup invite codes, comma-separated.
# Empty means mentor signup is CLOSED, which is the safe default: without a
# gate, anyone could register as a counsellor and immediately start receiving
# private messages from students in distress.
# MENTOR_INVITE_CODES=YOUR-INVITE-CODE,YOUR-SECOND-CODE


# ── Seeding (never read by the application) ──────────────────────────────────

# Used only by scripts/seed-mentors.mjs, so a demo password never enters the
# repository. If unset the script generates one and prints it once.
# MENTOR_SEED_PASSWORD=choose-something-long
