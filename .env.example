# ── Frontend (exposed to browser) ─────────────────────────────
# Clerk publishable key — dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Optional: override API base URL (defaults to /api — correct for Vercel and local proxy)
# VITE_API_URL=http://localhost:3001/api

# ── Backend (server-side only — NEVER prefixed with VITE_) ────
# Neon Postgres connection string — console.neon.tech
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Google Gemini API key — aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Local dev API server port
PORT=3001
